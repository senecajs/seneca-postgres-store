From 2c158b2bfbc59bc9e27786454640b470adbdc4bc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 11:39:23 +0000
Subject: [PATCH] Run CI on Node 24 and 22 with a postgres service container

The workflow triggered on main only, while the default branch is
master, and had no database. Add a postgres:18 service container on
port 55432 with a health check, load the test schema with psql, and
test on Node 24.x and 22.x.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaHppcejXbSsAH4BZXNsjV
---
 .github/workflows/build.yml | 43 +++++++++++++++++++++++++++++++++----
 1 file changed, 39 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 0cacbf2..de2af95 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -2,19 +2,54 @@ name: build
 
 on:
   push:
-    branches: [main]
+    branches: [master, main]
   pull_request:
-    branches: [main]
+    branches: [master, main]
 
 jobs:
   build:
     runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        node-version: [24.x, 22.x]
+
+    services:
+      postgres:
+        image: postgres:18
+        env:
+          POSTGRES_USER: senecatest
+          POSTGRES_PASSWORD: senecatest_2086hab80y
+          POSTGRES_DB: senecatest_71v94h
+        ports:
+          - 55432:5432
+        options: >-
+          --health-cmd "pg_isready -h 127.0.0.1 -U senecatest -d senecatest_71v94h"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 20
+
+    env:
+      SENECA_TEST_PG_HOST: 127.0.0.1
+      SENECA_TEST_PG_PORT: 55432
+      SENECA_TEST_PG_USER: senecatest
+      SENECA_TEST_PG_PASSWORD: senecatest_2086hab80y
+      SENECA_TEST_PG_DATABASE: senecatest_71v94h
+
     steps:
       - uses: actions/checkout@v4
-      - name: Use Node.js 24
+      - name: Use Node.js ${{ matrix.node-version }}
         uses: actions/setup-node@v4
         with:
-          node-version: '24'
+          node-version: ${{ matrix.node-version }}
+      - name: Create test schema
+        run: psql -v ON_ERROR_STOP=1 -f test/support/dbschema.sql
+        env:
+          PGHOST: 127.0.0.1
+          PGPORT: 55432
+          PGUSER: senecatest
+          PGPASSWORD: senecatest_2086hab80y
+          PGDATABASE: senecatest_71v94h
       - run: npm install
       - run: npm run build --if-present
       - run: npm test
-- 
2.43.0

